		{
			"name": "6. Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"user@example.com\",\n    \"code\": \"123456\",\n    \"newPassword\": \"NewSecurePass123!@#\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/reset-password",
