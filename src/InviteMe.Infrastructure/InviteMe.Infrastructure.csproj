<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" />
    <ProjectReference Include="../InviteMe.Application/InviteMe.Application.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Persistence/Schema/*.sql" LogicalName="InviteMe.Schema.%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Notifications/Templates/EmailConfirmation.html" LogicalName="InviteMe.EmailConfirmation.html" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Persistence/Migrations/InvitationTemplateCatalogSeed.json" LogicalName="InviteMe.InvitationTemplateCatalogSeed.json" /></ItemGroup>
</Project>
