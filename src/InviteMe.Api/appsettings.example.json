{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=InviteMe;Username=postgres;Password=<your-postgresql-password>"
  },
  "Jwt": {
    "Issuer": "InviteMe",
    "Audience": "InviteMe.Web",
    "SigningKey": "<base64-of-at-least-32-random-bytes>",
    "ExpirationMinutes": 15,
    "RefreshExpirationDays": 30
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "WeddingMedia": {
    "LocalDirectory": "",
    "PublicBaseUrl": "",
    "MaximumFileSizeBytes": 5242880,
    "AllowedFormats": [ "jpeg", "png", "webp" ]
  },
  "Authentication": {
    "RefreshCookie": { "Secure": true, "SameSite": "Lax" }
  },
  "Smtp": {
    "Host": "<smtp-host, e.g. smtp.gmail.com>",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "<smtp-username>",
    "Password": "<smtp-app-password>",
    "From": "<sender-email>"
  },
  "AllowedHosts": "localhost"
}
