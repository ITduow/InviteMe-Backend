# Copy to .env and replace placeholders. Never commit .env.
# dotnet run loads the nearest .env automatically; host environment variables win.
# Restart the API after changing this file.

# AI Thank You Templates: required only for explicit generation. Keep real keys in .env/secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Docker Compose settings
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SIGNING_KEY=replace-with-base64-of-32-random-bytes

# API settings (defaults below target the Compose PostgreSQL database).
# For an installed PostgreSQL server, change Database and Username as needed.
ConnectionStrings__PostgreSQL="Host=localhost;Port=5432;Database=inviteme;Username=inviteme;Password=${POSTGRES_PASSWORD}"
Jwt__SigningKey=${JWT_SIGNING_KEY}
Frontend__Url=http://localhost:3000

# Optional one-time Admin bootstrap. Enable only with a dedicated unused email address;
# the seeder never promotes or modifies an existing account. Keep the password in a secret store.
# AdminBootstrap__Enabled=true
# AdminBootstrap__Email=admin@example.com
# AdminBootstrap__Password=use-a-unique-random-password-at-least-16-characters
# AdminBootstrap__DisplayName=InviteMe Administrator

# SMTP: replace placeholders to enable confirmation and password reset emails.
Smtp__Host='<smtp-host>'
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName='<smtp-username>'
Smtp__Password='<smtp-password>'
Smtp__From='<sender-email>'

# Optional invitation SMS. Use the service/sender enabled by SpeedSMS for your account.
# A valid token alone does not verify sender availability; a live "sender not found"
# response is reported as SPEEDSMS_SENDER_NOT_FOUND.
SpeedSMS__BaseUrl=https://api.speedsms.vn/index.php/
SpeedSMS__AccessToken=
SpeedSMS__SmsType=2
SpeedSMS__Sender=

# Optional SePay webhook for wedding gifts (Guest08/Couple08). In SePay choose auth "API Key" with the same value;
# webhook URL: https://<api-host>/api/webhooks/sepay
SePay__WebhookApiKey=
# Optional sandbox collection: guests pay this InviteMe account (SePay sandbox) instead of the couple's, and an admin with
# ADMIN_GIFT_PAYOUTS_MANAGE pays each couple out (transfer content = payout code PO...). Leave Enabled=false for direct gifts.
# Register the SePay webhook for money in AND money out of this account. BankBin = Napas BIN (970422 MBBank, 970418 BIDV...).
GiftCollection__Enabled=false
GiftCollection__BankBin=
GiftCollection__AccountNumber=
GiftCollection__AccountName=

# Optional Google login
# Authentication__Google__ClientId=your-client-id.apps.googleusercontent.com

# Refresh cookie: production requires Secure=true. None also requires Secure=true.
Authentication__RefreshCookie__Secure=true
Authentication__RefreshCookie__SameSite=Lax
