# Copy to .env and replace placeholders. Never commit .env.
# dotnet run loads the nearest .env automatically; host environment variables win.
# Restart the API after changing this file.

# Docker Compose settings
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SIGNING_KEY=replace-with-base64-of-32-random-bytes

# API settings (defaults below target the Compose PostgreSQL database).
# For an installed PostgreSQL server, change Database and Username as needed.
ConnectionStrings__PostgreSQL="Host=localhost;Port=5432;Database=inviteme;Username=inviteme;Password=${POSTGRES_PASSWORD}"
Jwt__SigningKey=${JWT_SIGNING_KEY}
Frontend__Url=http://localhost:3000

# SMTP: replace placeholders to enable confirmation and password reset emails.
Smtp__Host='<smtp-host>'
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName='<smtp-username>'
Smtp__Password='<smtp-password>'
Smtp__From='<sender-email>'

# Optional Google login
# Authentication__Google__ClientId=your-client-id.apps.googleusercontent.com

# Refresh cookie: production requires Secure=true. None also requires Secure=true.
Authentication__RefreshCookie__Secure=true
Authentication__RefreshCookie__SameSite=Lax
